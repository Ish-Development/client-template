{
  "permissions": {
    "allow": [
      "Bash(npx agent-browser:*)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then if git pull --ff-only --quiet >/dev/null 2>&1; then echo 'Got the latest version from GitHub.'; else echo 'Could not get the latest version from GitHub automatically. Tell the user in plain words, check git status, and ask before changing anything.'; fi; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/jev-copy-review.py\" 2>/dev/null || true",
            "timeout": 90,
            "statusMessage": "Jev is reviewing the copy"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/jev-task-router.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/jev-commit-guard.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Jev is checking the commit message"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "compound-writing": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-writing"
      }
    }
  },
  "enabledPlugins": {
    "compound-writing@compound-writing": true,
    "figma@claude-plugins-official": true
  }
}
